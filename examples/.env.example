# Merge into an existing .env; never overwrite application secrets.
# Public image: no registry login or local build needed.
# Select a published version; release notes also offer an optional digest pin.
PROXY_IMAGE=ghcr.io/lingmann/caddy-cloudflare-proxy:v1.0.0

# One hostname, or names separated by single spaces. All use one upstream.
# Quote a list: PROXY_HOSTNAMES="service.example.com api.example.com"
# Use registered names in the Cloudflare zone, without URLs, ports, or trailing dots.
PROXY_HOSTNAMES=service.example.com

# Reachable host:port, optionally prefixed with http:// or https://.
# No path or credentials. Not host localhost: that is the Caddy container itself.
PROXY_UPSTREAM=app:8080

# Host-only Compose port settings; do not pass these into the container environment.
# Explicit host interface; reserve LAN addresses in DHCP. Avoid 0.0.0.0 / :: by default.
CADDY_BIND_IP=192.168.1.10
CADDY_HTTPS_PORT=443

# Shared DNS-only target: IPv4 -> A, IPv6 -> AAAA, hostname -> CNAME.
# Usually the bind IP, or an alias that intended clients can resolve and reach.
# No URL, port, CIDR, loopback, link-local, or wildcard.
PROXY_DNS_TARGET=192.168.1.10

# Zone ID, not account ID. Token: Zone DNS Edit + Zone Read for this zone only.
# Serving, check, and prepare require a 40-character token, matching the pinned provider.
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_API_TOKEN=

# Only Let's Encrypt production/staging directory URLs are accepted.
# Omit for production: https://acme-v02.api.letsencrypt.org/directory
# Use staging only with separate Caddy volumes.
# ACME_CA=https://acme-staging-v02.api.letsencrypt.org/directory

# End-to-end verification: use a safe GET endpoint with a known response.
# Redirects are not followed. Use 401/403 if that is the expected auth boundary.
PROXY_VERIFY_PATH=/
PROXY_VERIFY_STATUS=200
# Optional literal UTF-8 substring in the first 64 KiB of the response body.
PROXY_VERIFY_BODY=
# Total deadline for all configured hostnames, including DNS resolution.
PROXY_VERIFY_TIMEOUT=120
